%% WearGait-PD: Master Optimization & Visualization Script
clear; clc; close all;

% --- 1. CONFIGURATION ---
warning('off', 'MATLAB:table:ModifiedAndSavedVarnames'); 
dataPath = 'C:\Users\hendr\OneDrive\Documents\TU Delft\MSc Robotics\Internship at Erasmus MC\gait_detection\WearGait-PD';

% --- 2. FILE INITIALIZATION ---
files = [dir(fullfile(dataPath, 'W*.csv')); dir(fullfile(dataPath, 'N*.csv'))];
if isempty(files)
    error('No CSV files found. Check your dataPath.');
end

allData = {}; 
nFiles = length(files);
fprintf('--- PHASE 1: ROBUST DATA PRE-LOADING (%d files) ---\n', nFiles);

for i = 1:nFiles
    try
        fprintf('Processing [%2d/%d]: %-25s ', i, nFiles, files(i).name);
        
        data = readtable(fullfile(dataPath, files(i).name));
        cols = data.Properties.VariableNames;
        
        % 1.1 ROBUST TIME CONVERSION
        rawTime = data.Time;
        if iscell(rawTime)
            time = str2double(strrep(rawTime, 'sec', ''));
        elseif isduration(rawTime)
            time = seconds(rawTime);
        else
            time = double(rawTime);
        end
        
        % 1.2 ROBUST COLUMN INDEXING
        idxX = find(contains(cols, 'Acc') & endsWith(cols, 'X'), 1);
        idxY = find(contains(cols, 'Acc') & endsWith(cols, 'Y'), 1);
        idxZ = find(contains(cols, 'Acc') & endsWith(cols, 'Z'), 1);
        if isempty(idxX), error('No Acc columns found.'); end
        
        accX = double(data{:, idxX}); accY = double(data{:, idxY}); accZ = double(data{:, idxZ});
        
        % 1.3 SIGNAL CLEANING
        vm = sqrt(accX.^2 + accY.^2 + accZ.^2);
        valid = ~isnan(vm) & ~isnan(time);
        vm = vm(valid); time = time(valid);
        fs = 1 / median(diff(time)); 
        
        % 1.4 GROUND TRUTH
        actIdx = find(contains(cols, 'Event') | contains(cols, 'Activity') | contains(cols, 'Label'), 1);
        labelData = string(data{valid, actIdx});
        y_true = contains(lower(labelData), ["walk", "stair", "gait", "jog", "free"]);
        
        % 1.5 SPECTROGRAM PRE-CALCULATION
        fs_int = round(fs);
        [S, F, T] = spectrogram(detrend(vm), 2*fs_int, fs_int, 512, fs);
        Cabs = abs(S).^2;
        y_true_binned = interp1(1:length(y_true), double(y_true), T*fs, 'nearest') > 0.5;
        
        allData{end+1} = struct('Cabs', Cabs, 'F', F, 'y_true', y_true_binned);
        fprintf('Done. (fs=%.1fHz)\n', fs);
    catch ME
        fprintf('FAILED: %s\n', ME.message);
    end
end

%% --- 3. GRID SEARCH OPTIMIZATION (DIMENSION-SAFE) ---
fprintf('\n--- PHASE 2: GRID SEARCHING PARAMETERS ---\n');

% Ranges to test
minFreqs = 0.2:0.01:1.5;
maxFreqs = 1.5:0.01:4.0;
pThreshs = [0.000001, 0.000005,0.00001, 0.00005,0.0001, 0.0005, 0.001];

[MF, XF, PT] = ndgrid(minFreqs, maxFreqs, pThreshs);
totalCombos = numel(MF);
optResults = zeros(totalCombos, 6); 

for k = 1:totalCombos
    fMin = MF(k); fMax = XF(k); pThresh = PT(k);
    TP = 0; FP = 0; FN = 0;
    
    for i = 1:length(allData)
        [maxPks, maxIdxs] = max(allData{i}.Cabs);
        peakFreqs = allData{i}.F(maxIdxs);
        
        % Force column orientation using (:)
        y_pred = (peakFreqs(:) >= fMin & peakFreqs(:) <= fMax & maxPks(:) > pThresh);
        y_true = allData{i}.y_true(:); 
        
        % Length alignment
        len = min(length(y_pred), length(y_true));
        y_pred = y_pred(1:len); y_true = y_true(1:len);
        
        TP = TP + sum(y_true == 1 & y_pred == 1);
        FP = FP + sum(y_true == 0 & y_pred == 1);
        FN = FN + sum(y_true == 1 & y_pred == 0);
    end
    
    prec = TP / (TP + FP); if isnan(prec), prec = 0; end
    rec  = TP / (TP + FN); if isnan(rec), rec = 0; end
    f1   = 2 * (prec * rec) / (prec + rec); if isnan(f1), f1 = 0; end
    optResults(k, :) = [fMin, fMax, pThresh, f1, prec, rec];
    
    if mod(k, 100) == 0, fprintf('Tested %d/%d combos...\n', k, totalCombos); end
end

%% --- 4. VISUALIZATION & FINAL RESULTS ---
[bestF1, idx] = max(optResults(:,4));
bestParams = optResults(idx, :);

fprintf('\nBEST PARAMETERS: fMin=%.2f, fMax=%.2f, pThresh=%.4f (F1=%.4f)\n', ...
        bestParams(1), bestParams(2), bestParams(3), bestF1);

% 3.1 OPTIMIZATION LANDSCAPE PLOT
figure('Color', 'w', 'Name', 'Gait Optimization Landscape');
% We use scatter3 because we have 3 variables (fMin, fMax, pThresh)
scatter3(optResults(:,1), optResults(:,2), optResults(:,3), 40, optResults(:,4), 'filled');
xlabel('Min Frequency (Hz)'); ylabel('Max Frequency (Hz)'); zlabel('Power Threshold');
cb = colorbar; ylabel(cb, 'F1-Score');
title('Hyperparameter Optimization Results');
grid on; view(45, 30);
colormap(parula);

% Highlight the best point
hold on;
plot3(bestParams(1), bestParams(2), bestParams(3), 'ro', 'MarkerSize', 15, 'LineWidth', 3);
text(bestParams(1), bestParams(2), bestParams(3), '  BEST', 'FontSize', 12, 'FontWeight', 'bold');