%% --- MStra Bayesian Hyperparameter Optimizer (Free-Living Data) ---
clear; clc; close all;
warning('off', 'MATLAB:datetime:AmbiguousInputFormat'); % Silence the format warnings

% --- 1. SETTINGS ---
dataPath = 'C:\Users\hendr\OneDrive\Documents\TU Delft\MSc Robotics\Internship at Erasmus MC\gait_detection\Free_living';
fs = 50;

% --- 2. DATA SPLITTING & PRE-LOADING ---
allFiles = dir(fullfile(dataPath, '*_annotated.csv'));
if isempty(allFiles), error('No files found!'); end

% Shuffle and Split (70% Train, 30% Test)
rng(42); 
idx = randperm(length(allFiles));
trainIdx = idx(1:round(0.7 * length(allFiles)));
testIdx  = idx(round(0.7 * length(allFiles))+1 : end);

fprintf('Pre-loading %d training files...\n', length(trainIdx));
trainingSet = pre_load_data(allFiles(trainIdx), dataPath);

% --- 3. DEFINE OPTIMIZATION VARIABLES ---
% Using ranges optimized for free-living stroke data
vars = [
    optimizableVariable('F_MIN',    [0.4, 1.5]),
    optimizableVariable('F_MAX',    [2.0, 5.0]),
    optimizableVariable('P_THRESH', [0.01, .0], 'Transform', 'log'), 
    optimizableVariable('A_THRESH', [0.01, 0.15]) 
];

% --- 4. RUN BAYESIAN OPTIMIZATION ---
fprintf('Starting Bayesian Optimization...\n');

objFunc = @(p) 1 - run_eval_iteration(p, trainingSet, fs);

% Using only one PlotFcn to simplify, or remove entirely if it keeps crashing
results = bayesopt(objFunc, vars, ...
    'MaxObjectiveEvaluations', 40, ...
    'IsObjectiveDeterministic', true, ...
    'PlotFcn', {@plotMinObjective}); 

% --- 5. EXTRACT BEST PARAMETERS ---
bestParams = results.XAtMinObjective;
fprintf('\n======================================\n');
fprintf('OPTIMIZATION COMPLETE\n');
disp(bestParams);
fprintf('======================================\n');

%% --- HELPER: OBJECTIVE FUNCTION ---
function avgF1 = run_eval_iteration(params, dataset, fs)
    allF1 = zeros(length(dataset), 1);
    windowSize = 2 * fs;
    stepSize   = 1 * fs;
    maxGap     = 1.5 / fs;

    for i = 1:length(dataset)
        data = dataset{i};
        vm = data.vm;
        y_true = data.y_true;
        time_vec = data.time_vec;
        
        y_pred = zeros(length(vm), 1);
        circularBuffer = zeros(windowSize, 1);
        detectionState = 0;

        for s = 2:length(vm)
            if (time_vec(s) - time_vec(s-1)) > maxGap
                circularBuffer(:) = 0; detectionState = 0; continue;
            end
            
            circularBuffer = [circularBuffer(2:end); vm(s)];
            
            if mod(s, stepSize) == 0 && s >= windowSize
                % Logic from run_mstra_rt
                ampVal = std(circularBuffer);
                nfft = 512;
                w = hann(windowSize);
                winProc = (circularBuffer - mean(circularBuffer)) .* w;
                S = fft(winProc, nfft);
                P = abs(S(1:nfft/2+1)).^2;
                [maxPk, maxIdx] = max(P);
                freqs = fs * (0:(nfft/2)) / nfft;
                peakF = freqs(maxIdx);
                
                rawDecision = (peakF >= params.F_MIN && peakF <= params.F_MAX && ...
                               maxPk > params.P_THRESH && ampVal > params.A_THRESH);
                
                isGait = (detectionState & rawDecision);
                detectionState = rawDecision;
                y_pred(s - stepSize + 1 : s) = double(isGait);
            end
        end
        
        evalIdx = windowSize:length(vm);
        tp = sum(y_true(evalIdx) == 1 & y_pred(evalIdx) == 1);
        fp = sum(y_true(evalIdx) == 0 & y_pred(evalIdx) == 1);
        fn = sum(y_true(evalIdx) == 1 & y_pred(evalIdx) == 0);
        
        prec = tp / (tp + fp); if isnan(prec), prec = 0; end
        rec  = tp / (tp + fn); if isnan(rec),  rec  = 0; end
        f1   = 2 * (prec * rec) / (prec + rec); if isnan(f1), f1 = 0; end
        allF1(i) = f1;
    end
    avgF1 = mean(allF1);
end

%% --- HELPER: DATA PRE-LOADER ---
function dataset = pre_load_data(files, dataPath)
    dataset = cell(length(files), 1);
    for i = 1:length(files)
        fullPath = fullfile(dataPath, files(i).name);
        temp = readtable(fullPath, 'VariableNamingRule', 'preserve');
        
        % FIXED FORMAT: yyyy/MM/dd HH:mm:ss.SSS
        tRaw = temp{:, 'time'};
        if iscell(tRaw), tRaw = string(tRaw); end
        
        % We try parsing with the specific format you provided
        dt = datetime(tRaw, 'InputFormat', 'yyyy/MM/dd HH:mm:ss.SSS');
        
        s.vm = sqrt(temp.ax.^2 + temp.ay.^2 + temp.az.^2);
        s.time_vec = seconds(dt - dt(1));
        s.y_true = temp.Label;
        if iscell(s.y_true) || isstring(s.y_true), s.y_true = str2double(s.y_true); end
        
        dataset{i} = s;
    end
end